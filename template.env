# ------------------------------------------------------------------------------
# Gridworks Db Models - Example Environment Configuration
# Copy this file to `.env` and adjust the values as appropriate.
# ------------------------------------------------------------------------------


# Gridworks database connection string
GW_DATA_DB_URL=postgresql+psycopg://gw_admin:<%PASSWORD%>@<%SERVER%>:<%PORT%>/tsdb

# Optional: override logging level (DEBUG/INFO/WARNING/ERROR)
GW_DATA_LOG_LEVEL=INFO

# Optional: filesystem path for registry logs
# Recommended default matches GridWorks convention.
GW_DATA_LOG_DIR=~/.local/state/gridworks/GW_DATA/log

# Optional: enable SQLAlchemy echo for debugging
GW_DATA_DB_ECHO=false