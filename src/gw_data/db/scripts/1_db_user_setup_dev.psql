-- LOCAL DEV ONLY. Same roles as 1_db_user_setup.psql, created
-- non-interactively with password = role name, so that every GridWorks
-- consumer's default db_url works against the local container with no
-- .env. Never run against a shared or production server.

REVOKE CONNECT ON DATABASE tsdb FROM PUBLIC;

CREATE USER gw_admin PASSWORD 'gw_admin';
GRANT ALL ON DATABASE tsdb TO gw_admin;

CREATE USER gw_journalkeeper PASSWORD 'gw_journalkeeper';
GRANT CONNECT ON DATABASE tsdb TO gw_journalkeeper;

CREATE USER gw_visualizer PASSWORD 'gw_visualizer';
GRANT CONNECT ON DATABASE tsdb TO gw_visualizer;

CREATE USER gw_alerts PASSWORD 'gw_alerts';
GRANT CONNECT ON DATABASE tsdb TO gw_alerts;
ALTER ROLE gw_alerts SET statement_timeout = '2min';

CREATE USER gw_analyst PASSWORD 'gw_analyst';
GRANT CONNECT ON DATABASE tsdb TO gw_analyst;
ALTER ROLE gw_analyst SET statement_timeout = '2min';

-- Statement timeouts: a runaway query kills itself, not the journal.
ALTER ROLE gw_visualizer    SET statement_timeout = '10s';
ALTER ROLE gw_journalkeeper SET statement_timeout = '10s';

-- Database-wide: a client that opens a transaction and goes away cannot
-- hold a backend. Role-level statement_timeout is per consumer above.
ALTER DATABASE tsdb SET idle_in_transaction_session_timeout = '5min';
